# =========================================================================
# fw-audit environment configuration. Copy to `.env` and fill in as needed.
# All variables are optional; sensible defaults are applied in settings.py.
# =========================================================================

# ---- LLM API providers -------------------------------------------------
# Both Stage 1's Identifier Agent and Stage 3 Component 2's vulnerability
# analyst are routed to ModelTier.HIGH_REASONING by default (see
# fw_audit/config/llm_config.py's ROLE_TO_TIER) -> Anthropic Claude Sonnet.
# Set ANTHROPIC_API_KEY below for the production path.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Point at a local OpenAI-compatible server (vLLM, LM Studio) to run the
# "openai" provider fully offline. Leave unset to use real OpenAI.
OPENAI_BASE_URL=
GOOGLE_API_KEY=

# ---- Local LLM (Ollama) — offline testing only --------------------------
# Both HIGH_REASONING-routed roles (Stage 1's identifier, Stage 3's
# analyst) require ANTHROPIC_API_KEY (or another provider key) by default.
# To run either fully offline instead — no cloud key, no network — set:
#   FWA_LLM_MODEL=ollama:qwen2.5-coder:1.5b
# (or FWA_STAGE3_ANALYST_MODEL for just the Stage 3 analyst; see below).
# Requires:
#   1. Ollama running locally: https://ollama.com
#   2. The model pulled:       ollama pull qwen2.5-coder:1.5b
# Expect substantially lower finding quality from a 1.5B model — this path
# verifies plumbing, not analysis quality.
OLLAMA_BASE_URL=http://localhost:11434

# Ollama's server-side default context window is only 2048 tokens, which
# silently truncates any non-trivial prompt. Applied to every Ollama-backed
# spec (see llm_config._credential_kwargs). Raise this if a chunk's prompt
# (see FWA_STAGE3_CHUNK_LINES below — with [Lnnn] line markers, a chunk can
# run ~6-12 tokens/line) is landing close to or over this ceiling, which
# starves the model of room to emit a large structured JSON response.
FWA_OLLAMA_NUM_CTX=32768
# Hard cap on Ollama generation length. Guards against a small/local model's
# degenerate repetition loops, but too low will truncate a large structured
# response (e.g. Stage 3's AnalysisReport, which nests several findings)
# mid-JSON, causing an OUTPUT_PARSING_FAILURE ("Invalid json output").
FWA_OLLAMA_NUM_PREDICT=4096

# ---- LLM model routing overrides ----------------------------------------
# Global override, applied to every role that has no more specific
# override, "<provider>:<model>" e.g. "anthropic:claude-sonnet-4-5" or
# "ollama:qwen2.5-coder:1.5b". Leave unset to use the ROLE_TO_TIER/
# TIER_TO_SPEC defaults in llm_config.py.
FWA_LLM_MODEL=
# Per-role override for Stage 3 Component 2's analyst specifically — takes
# precedence over FWA_LLM_MODEL for that role only.
FWA_STAGE3_ANALYST_MODEL=

# API-vs-local preference, consulted only when neither override above is
# set. false (default) = prefer the API-backed model (Anthropic Claude
# Sonnet); true = prefer the local Ollama model instead. Whichever is NOT
# preferred is used automatically as a fallback if the preferred one is
# unavailable (e.g. no ANTHROPIC_API_KEY -> falls back to Ollama; local
# preferred but Ollama unreachable -> falls back to the API model if a
# credential exists). An error is raised only if neither mode is usable.
FWA_USE_LOCAL_MODEL=false

# ---- Application settings (prefix FWA_) --------------------------------
FWA_ENVIRONMENT=development
FWA_LOG_LEVEL=INFO

# ---- Observability: LangSmith tracing (Stages 3, 4, 5) -------------------
# Off by default — fw_audit.observability is a complete no-op with nothing
# set below (no env var written, no `langsmith` import attempted). Turn on
# to get a filterable trace tree per Stage 3 chunk / Stage 4 finding /
# Stage 5 candidate: LLM calls, schema-repair retries, Chroma retrieval
# hits, and Joern's Docker CPG-build/script-run calls. See CLAUDE.md's
# "Observability" section and fw_audit/observability/'s module docstrings.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=fw-audit
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Redact prompt/completion bodies from uploaded traces (keeps run
# structure/timing/metadata) — off by default, since this project's
# default is LangSmith cloud with payloads included:
# LANGSMITH_HIDE_INPUTS=false
# LANGSMITH_HIDE_OUTPUTS=false
# LANGSMITH_TRACING_SAMPLE_RATE=1.0

# Directories (defaults live under ./data)
# FWA_FIRMWARE_DIR=./data/firmware
# FWA_DATABASE_DIR=./data/db

# ---- Execution backend --------------------------------------------------
# "docker" (default, production) - Extraction Script runs in the sandbox
#   container defined by docker/Dockerfile. Requires the Docker daemon and
#   the image built: docker build -f docker/Dockerfile -t fw-audit-sandbox:latest .
# "local"  - runs commands directly on the host. Tests/dev only; never used
#   for real firmware extraction in the shipped pipeline.
# "sandbox" - LLM-controlled execution. Stage 5's Joern verification agent
#   is its first real consumer (fw_audit/stage5_verification/tools/
#   joern_tool.py) - one-shot per call like "docker", but with tighter
#   resource limits (see the FWA_STAGE5_SANDBOX_* vars below).
FWA_EXECUTOR_BACKEND=docker
FWA_DOCKER_BIN=docker
FWA_DOCKER_IMAGE=fw-audit-sandbox:latest

# When true (default) and on a POSIX host, every DockerExecutor/
# SandboxExecutor `docker run` adds `--user "<host uid>:<host gid>"`, so the
# container writes to the bind-mounted data/db/ workspace as the SAME user
# that owns it on the host instead of whatever USER an image bakes in (e.g.
# docker/Dockerfile.ghidra's non-root `ghidra`, UID 1000). Prevents
# "Permission denied" writing into data/db/<stem>/stage2/binaries/.../ghidra/
# when the directory was created by a different host user (commonly: root).
# No-op on Windows. Set to false to restore the old image-default-user
# behavior (then chown/chmod data/db/ yourself if you hit permission errors).
FWA_DOCKER_RUN_AS_HOST_USER=true

# ---- External tool invocation (subprocess primitives) -------------------
# Prepended to every host-level command (LocalExecutor / the `docker` CLI
# call only — never used for tools running inside the sandbox image).
FWA_COMMAND_PREFIX=

# Per-command timeout (seconds).
FWA_SUBPROCESS_TIMEOUT_SECONDS=900

# ---- Stage 2: Ghidra decompilation --------------------------------------
# `fw-extract` runs Ghidra Headless in a SEPARATE image from Stage 1's
# sandbox (Ghidra + JDK is ~2GB and Stage 1 starts its container 6+ times
# per firmware, so bundling them would tax every one of those starts for no
# benefit). Build it before running fw-extract for real:
#   docker build -f docker/Dockerfile.ghidra -t fw-audit-ghidra:latest .
FWA_GHIDRA_IMAGE=fw-audit-ghidra:latest

# Wall-clock cap for ONE analyzeHeadless invocation (one binary). Distinct
# from FWA_SUBPROCESS_TIMEOUT_SECONDS above — a multi-MB stripped MIPS
# binary routinely exceeds that.
FWA_GHIDRA_TIMEOUT_SECONDS=3600
# Passed to analyzeHeadless as -analysisTimeoutPerFile.
FWA_GHIDRA_ANALYSIS_TIMEOUT_SECONDS=1800
# JVM heap, applied via `_JAVA_OPTIONS` inside the container command.
FWA_GHIDRA_MAX_MEM=4g
FWA_GHIDRA_MAX_CPU=2
# Router binaries routinely exceed 10,000 functions; capped, largest first.
FWA_GHIDRA_MAX_FUNCTIONS=2000
FWA_GHIDRA_DECOMPILE_TIMEOUT_SECONDS=60
FWA_GHIDRA_EMIT_STRINGS=true

# Binaries decompiled in parallel. Default 1: each JVM reserves
# FWA_GHIDRA_MAX_MEM, so N concurrent means N x that on the host.
FWA_STAGE2_CONCURRENCY=1
FWA_STAGE2_MAX_BINARIES=25
FWA_STAGE2_MAX_RESCAN_FILES=200000

# Stage 3: analysis core (ingest/clean/chunk/queue -- Component 1) plus the
# LLM vulnerability-analysis worker pool (Component 2). CHUNK_LINES is the
# soft per-chunk line target, MAX_CHUNK_LINES the hard cap (see
# chunk.strategy.chunk_source). DEBUG_DUMP dumps raw+cleaned source per
# target; CHUNK_DEBUG_DUMP independently dumps chunk payloads (--debug /
# --debug-chunks respectively on the fw-analyze CLI). QUEUE_MAXSIZE/
# WORKERS/MAX_ATTEMPTS govern chunk_queue.run_queue() (--queue / --analyze),
# the in-process asyncio.Queue + worker pool Component 2's analyst consumer
# runs inside.
FWA_STAGE3_CHUNK_LINES=1000
FWA_STAGE3_MAX_CHUNK_LINES=4000
# Raising these on a local Ollama model trades chunk count for prompt size —
# a chunk's [Lnnn]-marked prompt runs roughly 6-12 tokens/line, so a 5000+
# line chunk can approach or exceed FWA_OLLAMA_NUM_CTX before the model even
# starts generating a response. If you raise these, raise FWA_OLLAMA_NUM_CTX
# (and likely FWA_OLLAMA_NUM_PREDICT) to match.
FWA_STAGE3_DEBUG_DUMP=false
FWA_STAGE3_CHUNK_DEBUG_DUMP=false
FWA_STAGE3_QUEUE_MAXSIZE=6
FWA_STAGE3_QUEUE_WORKERS=3
FWA_STAGE3_QUEUE_MAX_ATTEMPTS=3

# Stage 3 Component 2: the LLM analyst worker pool (--analyze). Per-chunk
# wall-clock timeout, base exponential-backoff delay before a retried
# chunk, the approx-token ceiling above which a chunk is skipped rather
# than sent to the LLM, and how many extra in-process attempts
# agent.analyst.analyze_chunk makes when structured output fails schema
# validation (0 disables repair).
FWA_STAGE3_LLM_TIMEOUT_SECONDS=300
FWA_STAGE3_LLM_RETRY_BACKOFF_SECONDS=2.0
FWA_STAGE3_MAX_CHUNK_TOKENS=100000
FWA_STAGE3_REPAIR_ATTEMPTS=1

# `method=` passed to with_structured_output(...) in agent.analyst.
# analyze_chunk: "json_schema" (default), "function_calling", or
# "json_mode". Left at "json_schema" for the production Anthropic/Google/
# OpenAI backends. Only override for a local Ollama model whose chat
# template can't render the json_schema `format=` payload reliably —
# observed on a custom Ollama build (a non-stock RENDERER/PARSER pair) as
# "no user query found in messages" regardless of method used; the actual
# fix there was switching to a stock-template Ollama model, not this
# setting, but it's a cheap first thing to try if you hit that error.
FWA_STAGE3_STRUCTURED_OUTPUT_METHOD=json_schema

# When true, prints the exact system+human message(s) sent to the analyst
# LLM to the console (INFO level, so FWA_LOG_LEVEL=INFO already shows it —
# no need to also enable global DEBUG). Off by default: the prompt includes
# the entire chunk's source text, so this is verbose — a debugging aid for
# seeing exactly what's being sent, not something to leave on for a full run.
FWA_STAGE3_LOG_PROMPTS=false

# ---- Stage 5: sandboxed verification (Joern tool-calling agent) ---------
# `fw-verify` runs the repo's first genuine multi-turn tool-calling agent
# loop (build_cpg / run_joern_script, bound via LangGraph) against a
# SEPARATE image from Stage 1/2's (Joern's JVM install is unrelated to
# either). Build it before running fw-verify for real:
#   docker build -f docker/Dockerfile.joern -t fw-audit-joern:latest .
FWA_STAGE5_JOERN_IMAGE=fw-audit-joern:latest

# Shared override applied to BOTH Stage 5 roles (script generator + result
# evaluator) unless a role-specific override below is also set — same
# "<provider>:<model>" syntax as FWA_STAGE3_ANALYST_MODEL. Set this to run
# the whole verification pipeline against a local model instead of the
# HIGH_REASONING default (Claude Sonnet, which requires a paid
# ANTHROPIC_API_KEY — a Claude Code/claude.ai login does NOT work here), e.g.:
#   FWA_STAGE5_VERIFIER_MODEL=ollama:qwen3:32b
FWA_STAGE5_VERIFIER_MODEL=

# Per-role overrides, each taking precedence over FWA_STAGE5_VERIFIER_MODEL
# for that role only — e.g. to mix a cheap local script generator with a
# stronger judge:
#   FWA_STAGE5_GENERATOR_MODEL=ollama:qwen3:32b
#   FWA_STAGE5_EVALUATOR_MODEL=anthropic:claude-sonnet-4-5
FWA_STAGE5_GENERATOR_MODEL=
FWA_STAGE5_EVALUATOR_MODEL=

# Per-tool-call wall-clock caps: building a CPG from a whole-program .c file
# is typically slower than running one query against it, hence the larger
# default for the former.
FWA_STAGE5_JOERN_TIMEOUT_SECONDS=300
FWA_STAGE5_CPG_BUILD_TIMEOUT_SECONDS=900

# Hard cap on generate -> run -> evaluate rounds in the verification
# pipeline before a FAIL_RETRY verdict is downgraded to FAIL_STOP instead of
# looping again — bounds runaway loops, especially against a smaller local
# model. And how many extra in-process attempts the evaluate step makes
# when the evaluator's response fails to parse as JSON (0 disables repair)
# — same pattern as FWA_STAGE3_REPAIR_ATTEMPTS.
FWA_STAGE5_MAX_AGENT_ITERATIONS=6
FWA_STAGE5_REPAIR_ATTEMPTS=1

# Resource caps SandboxExecutor applies (never DockerExecutor) — this
# backend runs LLM-authored script content, so it gets a tighter posture
# than the fixed deterministic pipelines DockerExecutor runs.
FWA_STAGE5_SANDBOX_MEMORY=4g
FWA_STAGE5_SANDBOX_CPUS=2.0
FWA_STAGE5_SANDBOX_PIDS_LIMIT=256

# Worker-pool sizing for `fw-verify run`, kept smaller than Stage 4's
# defaults — each candidate here drives a multi-turn agent loop plus a
# Docker CPG build, far more expensive per item than a RAG retrieval call.
FWA_STAGE5_WORKERS=2
FWA_STAGE5_QUEUE_MAXSIZE=4
FWA_STAGE5_QUEUE_MAX_ATTEMPTS=2

# When true, stage5/workspace/<gid>/ (copied source, built CPG, every
# script attempt) is left on disk after a run instead of being cleaned up —
# debugging convenience only.
FWA_STAGE5_KEEP_WORKSPACE=false

# ---- Stage 5 FVVW v3: fork-join orchestration ----------------------------
# `fw-verify run` drives the full fork-join by DEFAULT (strategy plan ->
# static Joern track + dynamic QEMU+GDB track run independently -> joint
# two-axis verdict -> LLM disclosure report). `fw-verify run --joern-only`
# routes to the ORIGINAL static-only pipeline above, unchanged.
#
# Per-role overrides for the two new LLM roles, same
# "<provider>:<model>" syntax, each falling back to FWA_STAGE5_VERIFIER_MODEL:
FWA_STAGE5_STRATEGY_MODEL=
FWA_STAGE5_REPORT_MODEL=

# "memory" (default, MemorySaver, per-process — what tests use) or "sqlite"
# (persists across process restarts, needed for bringup_stabilize repair
# resume in a long-running production queue — requires
# `pip install -e ".[stage5-fvvw]"`).
FWA_STAGE5_CHECKPOINT_BACKEND=memory

# ---- Stage 5 FVVW v3: dynamic (QEMU+GDB) verification track --------------
# The superset sandbox image backing characterize_target/static_crosscheck/
# the whole dynamic track — a SEPARATE image from FWA_STAGE5_JOERN_IMAGE
# above (the static track keeps using that one, unaffected). Build it
# before running the fork-join for real:
#   docker build -f docker/Dockerfile.verification \
#       -t fw-audit-verification-sandbox:latest .
FWA_STAGE5_VERIFICATION_IMAGE=fw-audit-verification-sandbox:latest

# Wall-clock caps for one QEMU bring-up/launch step and one
# gdb-multiarch -batch -x recipe.gdb call, respectively.
FWA_STAGE5_QEMU_TIMEOUT_SECONDS=120
FWA_STAGE5_GDB_TIMEOUT_SECONDS=60

# Cap on bringup_stabilize repair attempts within one dynamic-track run
# before giving up (mem.dynamic.result = not_run, distinct from refuted).
FWA_STAGE5_BRINGUP_MAX_REPAIRS=5

# Cap on dynamic_evaluate's retry/hypothesis-switch loop (reach -> guards ->
# trigger -> collect -> evaluate), per active hypothesis (A then B), before
# forcing an inconclusive terminal verdict.
FWA_STAGE5_DYNAMIC_MAX_ITERATIONS=4

# Master switch for bringup_stabilize's scoped, per-run network grant. When
# false (the default), every dynamic-track container stays --network=none
# even if a target would otherwise need a reachable socket — that repair
# case is instead reported as a residual unknown rather than silently
# opening egress. Set true only for an operator who has read and accepted
# that a specific run's container may gain scoped, revoked-after egress.
FWA_STAGE5_ALLOW_NETWORK_GRANT=false

# Override for where a dynamic-track session's rootfs copy/scratch files
# are staged on the host — defaults to
# stage5/fvvw/dynamic_workspace/<gid>/ under the run's own db_subfolder
# when unset.
FWA_STAGE5_DYNAMIC_WORKSPACE_ROOT=

# Master switch for per-track command logging — every command either
# fork-join track executes, plus its full result, appended to
# stage5/fvvw/logs/<gid>.<static|dynamic>.jsonl. Unlike LangSmith tracing,
# stays on by default and is NOT governed by LANGSMITH_TRACING: the whole
# point is a diagnosable run with no --trace/LangSmith account.
FWA_STAGE5_COMMAND_LOG=true

# ---- Stage 5 HITL: human-in-the-loop on inconclusive tracks ---------------

# "off" (default, fully unattended) or "prompt" — when a track exhausts its
# own iteration/repair budget without a decisive verdict, the fork-join
# pauses after the barrier and offers retry/override_plan/inject/
# force_verdict/skip. See `fw-verify run --hitl=prompt`.
FWA_STAGE5_HITL_MODE=off

# Bounds the retry/override/inject prompt loop for ONE candidate — an
# unattended terminal cannot spin the same candidate forever.
FWA_STAGE5_HITL_MAX_ROUNDS=3

# Default extra-iterations count for HITL's "retry with more iterations"
# action when the operator doesn't specify a different number.
FWA_STAGE5_HITL_EXTRA_ITERATIONS=4
