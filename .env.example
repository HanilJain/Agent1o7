# =========================================================================
# fw-audit environment configuration. Copy to `.env` and fill in as needed.
# All variables are optional; sensible defaults are applied in settings.py.
# =========================================================================

# ---- LLM API providers -------------------------------------------------
# Stage 1's Identifier Agent REQUIRES one working LLM provider (hard fail
# otherwise). Configure Ollama below, or set one API key here.
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ---- Local LLM (Ollama) ------------------------------------------------
# Stage 1's Identifier Agent (fw_audit/config/llm_config.py) currently
# routes to FAST_LOCAL -> Ollama qwen2.5-coder:1.5b by default (no cloud
# key configured in this dev environment). Requires:
#   1. Ollama running locally: https://ollama.com
#   2. The model pulled:       ollama pull qwen2.5-coder:1.5b
# Set ANTHROPIC_API_KEY or GOOGLE_API_KEY and flip ROLE_TO_TIER back to
# HIGH_REASONING in llm_config.py for better accuracy in production.
OLLAMA_BASE_URL=http://localhost:11434

# ---- Application settings (prefix FWA_) --------------------------------
FWA_ENVIRONMENT=development
FWA_LOG_LEVEL=INFO

# Directories (defaults live under ./data)
# FWA_FIRMWARE_DIR=./data/firmware
# FWA_DATABASE_DIR=./data/db

# ---- Execution backend --------------------------------------------------
# "docker" (default, production) - Extraction Script runs in the sandbox
#   container defined by docker/Dockerfile. Requires the Docker daemon and
#   the image built: docker build -f docker/Dockerfile -t fw-audit-sandbox:latest .
# "local"  - runs commands directly on the host. Tests/dev only; never used
#   for real firmware extraction in the shipped pipeline.
# "sandbox" - reserved for future LLM-controlled execution stages; not
#   implemented yet (see fw_audit/executors/sandbox_executor.py).
FWA_EXECUTOR_BACKEND=docker
FWA_DOCKER_BIN=docker
FWA_DOCKER_IMAGE=fw-audit-sandbox:latest

# ---- External tool invocation (subprocess primitives) -------------------
# Prepended to every host-level command (LocalExecutor / the `docker` CLI
# call only — never used for tools running inside the sandbox image).
FWA_COMMAND_PREFIX=

# Per-command timeout (seconds).
FWA_SUBPROCESS_TIMEOUT_SECONDS=900

# ---- Stage 2: Ghidra decompilation --------------------------------------
# `fw-extract` runs Ghidra Headless in a SEPARATE image from Stage 1's
# sandbox (Ghidra + JDK is ~2GB and Stage 1 starts its container 6+ times
# per firmware, so bundling them would tax every one of those starts for no
# benefit). Build it before running fw-extract for real:
#   docker build -f docker/Dockerfile.ghidra -t fw-audit-ghidra:latest .
FWA_GHIDRA_IMAGE=fw-audit-ghidra:latest

# Wall-clock cap for ONE analyzeHeadless invocation (one binary). Distinct
# from FWA_SUBPROCESS_TIMEOUT_SECONDS above — a multi-MB stripped MIPS
# binary routinely exceeds that.
FWA_GHIDRA_TIMEOUT_SECONDS=3600
# Passed to analyzeHeadless as -analysisTimeoutPerFile.
FWA_GHIDRA_ANALYSIS_TIMEOUT_SECONDS=1800
# JVM heap, applied via `_JAVA_OPTIONS` inside the container command.
FWA_GHIDRA_MAX_MEM=4g
FWA_GHIDRA_MAX_CPU=2
# Router binaries routinely exceed 10,000 functions; capped, largest first.
FWA_GHIDRA_MAX_FUNCTIONS=2000
FWA_GHIDRA_DECOMPILE_TIMEOUT_SECONDS=60
FWA_GHIDRA_EMIT_STRINGS=true

# Binaries decompiled in parallel. Default 1: each JVM reserves
# FWA_GHIDRA_MAX_MEM, so N concurrent means N x that on the host.
FWA_STAGE2_CONCURRENCY=1
FWA_STAGE2_MAX_BINARIES=25
FWA_STAGE2_MAX_RESCAN_FILES=200000
