# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Secrets / local config
.env
.env.*
!.env.example

# Firmware inputs & the extraction Database (can be huge; never commit)
data/firmware/*
data/db/*
!data/firmware/.gitkeep
!data/db/.gitkeep

# OS noise
.DS_Store
Thumbs.db

# Pre-fetched build inputs for docker/Dockerfile.joern (~1.8GB release
# asset, downloaded locally to work around this environment's flaky
# long-lived HTTP/2 connections — never commit it; see Dockerfile.joern's
# fetch stage comment for why it's referenced via local COPY instead of a
# RUN curl).
docker/.joern-cli.zip
